<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#E9E5DC">

    <!-- 顶部：标题 + 页面切换 -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="研途倒计时"
                android:textColor="#173B32"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="2027 考研 · 桌面小组件"
                android:textColor="#DA6A4F"
                android:textSize="11sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <Button
            android:id="@+id/tabManage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="管理台"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/pill_active"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/tabClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="桌面时钟"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:background="@drawable/pill_inactive"
            android:textColor="#173B32" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#19221F22" />

    <!-- 内容区 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- 页 1：管理台 -->
        <ScrollView
            android:id="@+id/pageManage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- 考试日期 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="考试日期"
                        android:textColor="#6F766F"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:id="@+id/currentDateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="2027.12.25"
                        android:textColor="#173B32"
                        android:textSize="26sp"
                        android:fontFamily="monospace" />

                    <Button
                        android:id="@+id/btnPickDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:paddingHorizontal="18dp"
                        android:paddingVertical="9dp"
                        android:text="选择日期"
                        android:textSize="13sp"
                        android:textAllCaps="false"
                        android:background="@drawable/pill_active"
                        android:textColor="#FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/quickButton2027"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="2027 考研"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="@drawable/pill_inactive"
                            android:textColor="#173B32" />

                        <Button
                            android:id="@+id/quickButtonReserve"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:minWidth="0dp"
                            android:minHeight="0dp"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="8dp"
                            android:text="预留日期"
                            android:textSize="12sp"
                            android:textAllCaps="false"
                            android:background="@drawable/pill_inactive"
                            android:textColor="#173B32" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 说明 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:background="@drawable/card_bg"
                    android:padding="18dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="怎么把小组件放到桌面"
                        android:textColor="#6F766F"
                        android:textSize="11sp"
                        android:fontFamily="monospace" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="4dp"
                        android:text="长按主屏幕空白处 → 选择「小组件」→ 找到「研途倒计时」→ 拖到桌面。\n\n长按已放置的小组件可调整大小，或点「配置」单独改它的考试日期。"
                        android:textColor="#19221F"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingVertical="12dp"
                    android:text="立即刷新小组件"
                    android:textSize="14sp"
                    android:textAllCaps="false"
                    android:background="@drawable/pill_active"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </ScrollView>

        <!-- 页 2：桌面时钟 -->
        <FrameLayout
            android:id="@+id/pageClock"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@drawable/clock_page_bg">

            <View
                android:id="@+id/clockGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:background="@drawable/clock_glow" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/clockHour"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="08"
                        android:textColor="@color/amber"
                        android:textSize="92sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/dseg7_classic_bold"
                        android:shadowColor="#F5BB56"
                        android:shadowRadius="14"
                        android:shadowDx="0"
                        android:shadowDy="0" />

                    <LinearLayout
                        android:id="@+id/clockColon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="10dp"
                        android:orientation="vertical"
                        android:gravity="center">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginBottom="10dp"
                            android:background="@drawable/clock_dot" />

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/clock_dot" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/clockMinute"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textColor="@color/amber"
                        android:textSize="92sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/dseg7_classic_bold"
                        android:shadowColor="#F5BB56"
                        android:shadowRadius="14"
                        android:shadowDx="0"
                        android:shadowDy="0" />

                    <TextView
                        android:id="@+id/clockSeconds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="45"
                        android:textColor="@color/amber_dim"
                        android:textSize="42sp"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/dseg7_classic_bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:alpha="0.22"
                android:clickable="false"
                android:focusable="false"
                android:background="@drawable/scanlines" />
        </FrameLayout>
    </FrameLayout>
</LinearLayout>